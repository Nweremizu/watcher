{
  "name": "@nweremizu/watcher-ui",
  "version": "0.1.1",
  "description": "Open your running React app like a design file: rulers, live style editing, canvas mode, an SVG editor, design-system extraction and a profiler. Dev-only, zero bytes in production.",
  "keywords": [
    "react",
    "devtools",
    "design",
    "inspector",
    "figma",
    "overlay",
    "css",
    "svg-editor",
    "design-system"
  ],
  "license": "MIT",
  "author": "Bruno Nweremizu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nweremizu/watcher.git"
  },
  "homepage": "https://github.com/nweremizu/watcher#readme",
  "bugs": "https://github.com/nweremizu/watcher/issues",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "production": "./dist/noop.js",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./package.json": "./package.json"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "assets"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "vite": ">=5"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json",
    "check": "tsc --noEmit && node checks/path.check.ts && node checks/writeback.check.ts && node checks/shortcut.check.ts && node checks/guard.check.ts && node checks/css.check.ts && node checks/anim.check.ts",
    "icons": "npm i -D framework7-icons@latest && node scripts/icons.ts",
    "prepublishOnly": "npm run check && npm run build"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "framework7-icons": "^5.0.5",
    "motion": "^14.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@babel/parser": "^8.0.7",
    "magic-string": "^1.4.3"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
